        "operation": "send",
        "sendTo": "={{ $('New subscriber').item.json.body.email }}",
        "subject": "Welcome: here is your booklet and one quick win",
        "emailType": "text",
        "message": "=Hi {{ $('New subscriber').item.json.body.firstName || 'friend' }},\n\n[Paste email 1 from emails/six-sales-sequence.md here]\n\nYOUR_NAME\n{{YOUR_BUSINESS_NAME}}",
